<div class="card">
  <div class="card-header">
    Listing categories
  </div>
  <div class="card-body">
    <div class="d-flex justify-content-between">
      <div>
        <%= paginate @categories %>
      </div>
      <div class="d-flex position-relative">
        <div>
          <a class="btn btn-primary" data-toggle="collapse" href="#collapse" aria-expanded="false" aria-controls="collapse">
            Search
          </a>
          <div class="collapse position-absolute" id="collapse" style="width: 300px; top: 100%; right: 0;">
            <%= render 'search_form' %>
          </div>
          <div class="collapse-content"></div>
        </div>
        <div>
          <%= link_to 'New Category', new_admin_category_path, class: 'btn btn-primary mb-3' %>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-bordered table-hover">
        <thead>
          <tr class="table-secondary">
            <th class="align-middle text-center"><%= sort_link(@q, :name) %></th>
            <th class="align-middle text-center"><%= sort_link(@q, :description) %></th>
            <th class="align-middle text-center"><%= sort_link(@q, :ready_for_public, 'Live?') %></th>
            <th style="width: 10%;"></th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td class="align-middle text-center">
                <%= link_to category.name, admin_category_path(category) %>
              </td>
              <td class="align-middle text-center">
                <%= snippet(category.description, :word_count => 10) %>
              </td>
              <td class="align-middle text-center">
                <%= decorate_boolean(category.ready_for_public?) %>
              </td>
              <td class="align-middle text-center">
                <%= link_to raw('<i class="far fa-edit"></i>'), edit_admin_category_path(category) %>
                &nbsp;
                <%= link_to raw('<i class="far fa-trash-alt"></i>'), [:admin, category], data: { confirm: 'Are you sure?' }, method: :delete %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= paginate @categories %>
  </div>
</div>
