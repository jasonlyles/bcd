<div class="card">
  <div class="card-header">
    Listing Users
  </div>
  <div class="card-body">
    <div class="d-flex justify-content-between">
      <div>
        <%= paginate @users %>
      </div>
      <div class="d-flex position-relative">
        <div>
          <a class="btn btn-primary mb-3" data-toggle="collapse" href="#collapse" aria-expanded="false" aria-controls="collapse">
            Search
          </a>
          <div class="collapse position-absolute" id="collapse" style="width: 300px; top: 100%; right: 0;">
            <%= render 'search_form' %>
          </div>
          <div class="collapse-content"></div>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-bordered table-hover">
        <thead>
          <tr class="table-secondary">
            <th class="align-middle text-center">Account Status</th>
            <th class="align-middle text-center">Email</th>
            <th class="align-middle text-center">Email Preference</th>
            <th class="align-middle text-center">Referrer Code</th>
            <th class="align-middle text-center">Total Spent</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="align-middle text-center">
                <%= decorate_account_status(user.account_status) %>
              </td>
              <td class="align-middle text-center">
                <%= link_to user.email, admin_user_path(user) %>
              </td>
              <td class="align-middle text-center">
                <%= user.email_preference.humanize %>
              </td>
              <td class="align-middle text-center">
                <%= user.referrer_code %>
              </td>
              <td>
                <%= number_to_currency(user.orders.map(&:total_price).sum.to_f) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= paginate @users %>
  </div>
</div>
