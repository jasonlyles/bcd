<div class="row mt-4 mb-2">
  <div class="col-auto mr-auto">
    <h1><%= @update.title %></h1>
  </div>
</div>
<div class="card">
  <div class="card-header d-flex justify-content-between">
    <b class="mt-2">Update</b>
    <%= link_to 'Edit', edit_admin_update_path(@update), class: 'btn btn-primary' %>
  </div>
  <div class="card-body">
    <table>
      <tr>
        <td>
          <b>Link:</b>
        </td>
        <td></td>
        <td class="pl-4">
          <%= @update.link %>
        </td>
      </tr>
      <tr>
        <td>
          <b>Live?</b>
        </td>
        <td></td>
        <td class="pl-4">
          <%= decorate_boolean(@update.live) %>
        </td>
      </tr>
    </table>
    <br />
    <%= form_for [:admin, @update] do |f| %>
      <div class="form-check">
        <%= f.check_box :live, { checked: !@update.live?, hidden: true } %>
      </div>
      <%= f.submit @update.live? ? 'Disable Update' : 'Enable Update', class: @update.live? ? 'btn btn-danger' : 'btn btn-success' %>
    <% end %>
  </div>
</div>
<%= link_to 'Back to Index', admin_updates_path %>
<p class="mt-2">Preview (If it doesn't look good here. It won't look good on the front page.)</p>
<section id="news" class="pt-5 pb-4 text-white">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-12 col-xl-10">
        <div class="row">
          <% 3.times do %>
            <div class="col-md-4 mb-4 d-flex">
              <!-- Ensure position-relative is present so stretched-link scopes to this card -->
              <div class="card content-card w-100 border-0 shadow-sm h-100 bg-white position-relative">
                <% if @update.image.present? %>
                  <div class="content-card-img-wrap">
                    <img src="<%= @update.image %>" class="card-img-top" alt="<%= @update.title %>" loading="lazy">
                  </div>
                <% end %>
                <div class="card-body d-flex flex-column p-4">
                  <h3 class="h5 card-title text-dark font-weight-bold mb-2">
                    <%= @update.title %>
                  </h3>
                  <p class="card-text text-secondary small mb-3">
                    <%= @update.body %>
                  </p>
                  <!-- Added 'stretched-link' below -->
                  <%= link_to 'Learn More', @update.link, class: 'btn btn-sm btn-outline-primary mt-auto align-self-start font-weight-bold stretched-link', aria: { label: "Learn more about #{@update.title}" } %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
