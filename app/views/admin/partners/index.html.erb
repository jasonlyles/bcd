<div class="card">
  <div class="card-header">
    Listing partners
  </div>
  <div class="card-body">
    <div class="d-flex justify-content-between">
      <div>
        <%= paginate @partners %>
      </div>
      <div class="d-flex position-relative">
        <div>
          <a class="btn btn-primary" data-toggle="collapse" href="#collapse" aria-expanded="false" aria-controls="collapse">
            Search
          </a>
          <div class="collapse position-absolute" id="collapse" style="width: 300px; top: 100%; right: 0;">
            <%= render 'search_form' %>
          </div>
          <div class="collapse-content"></div>
        </div>
        <div>
          <%= link_to 'New Partner', new_admin_partner_path, class: 'btn btn-primary mb-3' %>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-bordered table-hover">
        <thead>
          <tr class="table-secondary">
            <th class="align-middle text-center"><%= sort_link(@q, :name) %></th>
            <th class="align-middle text-center"><%= sort_link(@q, :url) %></th>
            <th class="align-middle text-center"><%= sort_link(@q, :contact) %></th>
            <th style="width: 10%;"></th>
          </tr>
        </thead>
        <tbody>
          <% @partners.each do |partner| %>
            <tr>
              <td class="align-middle text-center">
                <%= link_to partner.name, admin_partner_path(partner) %>
              </td>
              <td class="align-middle text-center">
                <%= link_to partner.url, partner.url, target: "_blank" %>
              </td>
              <td class="align-middle text-center">
                <%= partner.contact %>
              </td>
              <td class="align-middle text-center">
                <%= link_to raw('<i class="far fa-edit"></i>'), edit_admin_partner_path(partner) %>
                &nbsp;
                <%= link_to raw('<i class="far fa-trash-alt"></i>'), [:admin, partner], data: { confirm: 'Are you sure?' }, method: :delete %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= paginate @partners %>
  </div>
</div>
