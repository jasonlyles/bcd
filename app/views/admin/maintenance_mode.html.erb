<div class="row mt-4 mb-2">
  <div class="col-auto mr-auto">
    <h1>Maintenance Mode!</h1>
  </div>
</div>
<div class="card">
  <div class="card-header d-flex justify-content-end">
    <% if @mm_switch.on? %>
      <b class="text-danger mt-2">
        MAINTENANCE MODE ON
      </b>
    <% else %>
      <b class="text-success mt-2">
        Maintenance Mode Off
      </b>
    <% end %>
  </div>
  <div class="card-body">
    <p>
      Putting the site into maintenance mode effectively blocks out all non-admin users from using the site, but the admins can still access the entire site. Make sure you take the site back out of
      maintenance mode or else this site will be inaccessible to our users!
    </p>
    <br/>
    <%= form_for(:switches, :url => {:action => :switch_maintenance_mode}) do |f| %>
      <% if @mm_switch.on? %>
        <%= f.submit 'Take app out of Maintenance Mode', data: {disable_with: 'Going in...'}, class: 'btn btn-primary' %>
      <% else %>
        <%= f.submit 'Put app into Maintenance Mode', data: {disable_with: 'Going out...'}, class: 'btn btn-primary' %>
      <% end %>
    <% end %>
  </div>
</div>
