<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="content-type" content="text/html; charset=utf-8">
    <meta content="m6aCl_TMUyZi-kR1BIijxqWbYrix12cNmvBR7VWX6U0" name="google-site-verification"/>
    <meta name="google-adsense-account" content="ca-pub-8519388439178019">
    <% content_for :head do %>
      <meta name="keywords" content="<%= meta_keywords(@product) %>">
      <meta name="description" content="<%= meta_description(@product) %>">
    <% end %>
    <meta content="<%= content_for?(:og_image) ? yield(:og_image) : opengraph_metadata[:image] %>" property="og:image"/>
    <meta content="<%= content_for?(:og_title) ? yield(:og_title) : (content_for?(:title) ? yield(:title) : opengraph_metadata[:title]) %>" property="og:title"/>
    <meta content="<%= content_for?(:og_description) ? yield(:og_description) : opengraph_metadata[:description] %>" property="og:description"/>
    <meta content="<%= content_for?(:og_type) ? yield(:og_type) : opengraph_metadata[:type] %>" property="og:type"/>
    <meta content="<%= opengraph_metadata[:app_id] %>" property="fb:app_id"/>
    <meta content="<%= opengraph_metadata[:site_name] %>" property="og:site_name"/>
    <meta content="<%= opengraph_metadata[:url] %>" property="og:url"/>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://www.google-analytics.com">
    <%= favicon_link_tag asset_path('favicon.ico') %>
    <title><%= content_for?(:title) ? yield(:title) : "Brick City Depot" %></title>
    <%= stylesheet_link_tag 'application' %>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.13/css/all.css" integrity="sha384-DNOHZ68U8hZfKXOrtjWvjxusGo9WQnrNx2sqG0tfsghAvtVlRW3tvkXWZh58N9jp" crossorigin="anonymous">
    <script defer="defer" src="https://use.fontawesome.com/releases/v5.0.13/js/all.js" integrity="sha384-xymdQtn1n3lH2wcu0qhcdaOpQwyoarkgLVxC/wZ5q7h9gHtxICrpcaSUfygqZGOe" crossorigin="anonymous"></script>
    <%= javascript_include_tag 'application' %>
    <%= csrf_meta_tags %>
    <% if defined?(@canonical_url) && @canonical_url.present? %>
      <link rel="canonical" href="<%= @canonical_url %>">
    <% end %>
    <% if @noindex %>
      <meta name="robots" content="noindex, follow">
    <% end %>
    <%= yield :head %>
  </head>

  <body>
    <% if user_signed_in? %>
      <%= auto_session_timeout_js frequency: 120 %>
    <% end %>
    <%= render partial: 'shared/navigation' %>

    <main>
      <% unless current_page?(root_path) %>
        <div class="header-spacer"></div>
        <div id='flash_messages' class="container">
          <%= render partial: 'shared/notifications' %>
        </div>
        <div class="container">
          <% if @cart && @cart.errors.any? %>
            <ul class="cart_errors">
              <% @cart.errors.full_messages.each do |msg| %>
                <li class="cart_error">
                  <%= msg %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer">
      <%= render :partial => 'shared/footer' %>
      <%= render 'cookies_eu/consent_banner', link: '/cookies', target: '_blank' %>
    </footer>
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="gzceEaesbUi+zcqSOF9c4Q" async></script>
    <%= render :partial => 'shared/google_analytics_code' %>
    <%= render :partial => 'shared/google_social_profile' %>
    <script>
      window.onpageshow = function () {
        var cookie = getCookie('show_thank_you');
        if (cookie) {
          window.location.replace('/thank_you')
        }
      }

      function getCookie(name) {
        var value = "; " + document.cookie;
        var parts = value.split("; " + name + "=");
        if (parts.length == 2) {
          return parts.pop().split(";").shift();
        }
      }
    </script>
  </body>
</html>
