<div class="card mb-4 mt-4">
  <% unless product.main_image.blank? %>
    <div class="similar-product-header">
      <%= link_to(image_tag(product.main_image&.medium&.url, class: 'card-img-top img-fluid object-fit-cover'), { action: :product_details, product_code: product.product_code, product_name: product.name.to_snake_case }) unless product.main_image.medium.blank? %>
    </div>
  <% end %>
  <div class="card-body">
    <h5 class="card-title"><%= link_to product.code_and_name, { action: :product_details, product_code: product.product_code.downcase, product_name: product.name.to_snake_case } %></h5>
  </div>
  <div class="card-footer card-footer-no-border bg-transparent">
    <% if product.free? %>
      <span class="h4">
        <strong>FREE</strong>
      </span>
    <% else %>
      <span class="hero-price">
        <%= number_to_currency(product.current_price) %>
      </span>
      <div class="mt-2">
        <%= button_to add_to_cart_path(product.product_code),
              method: :post,
              class: 'btn btn-primary btn-block',
              data: { disable_with: 'Adding...' },
              form: { class: 'd-block' } do %>
          <i class="fas fa-cart-plus"></i>&nbsp;
          <span style="font-size:larger">Add to Cart</span>
        <% end %>

      </div>
    <% end %>
  </div>
</div>
