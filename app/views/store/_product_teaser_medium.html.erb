<div class="card mb-4 mt-1 mt-md-3">
  <div class="product-header">
    <%= link_to(image_tag(product.main_image&.medium&.url, class: 'card-img-top img-fluid', alt: "#{product.code_and_name} instructions", loading: "lazy"), { controller: :store, action: :product_details, product_code: product.product_code, product_name: product.name.to_snake_case}) if product&.main_image&.medium.present? %>
  </div>
  <div class="card-body">
    <h4 class="card-title h5"><%= link_to product.code_and_name, { controller: :store, action: :product_details, product_code: product.product_code, product_name: product.name.to_snake_case } %></h4>
    <p class="card-text">
      <%= snippet(product.description, word_count: 20) %>
      <br/>
      <%= link_to "Shop Now", { controller: :store, action: :product_details, product_code: product.product_code, product_name: product.name.to_snake_case } %>
    </p>
  </div>
  <div class="card-footer card-footer-no-border bg-transparent">
    <% if product.free? %>
      <span class="h4 float-right">
        <strong>FREE</strong>
      </span>
    <% else %>
      <span class="hero-price float-right">
        <% if product.discount_percentage > 0 %>
          <span class="text-danger pr-2">On Sale!</span>
        <% end %>
        <strong>$<%= product.current_price.floor %><span class='cents'><%= ("%.2f" % product.current_price).split('.')[1] %></span></strong>
      </span>
    <% end %>
    <div class="clear mb-4 pb-2"></div>
    <div class="mt-2">
      <%= link_to raw("<i class='fas fa-cart-plus'></i>&nbsp; <span style='font-size:larger'>Add to Cart</span>"), { controller: :store, action: "add_to_cart", product_code: product.product_code}, {class: 'btn btn-primary btn-block', data: {disable_with: 'Adding...'}, method:
      :post} %>
    </div>
  </div>
</div>
