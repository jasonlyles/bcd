<section class="content">
  <div class="container">
    <h1><%= @product_type.name %></h1>
    <br/>
    <p>
      <%= @product_type.description %>
    </p>
    <br/>
    <div class="container">
      <div class="row">
        <% @products.each do |product| %>
          <%= render partial: "product_teaser", locals: { product: } %>
        <% end %>
      </div>
      <div class="d-flex justify-content-center mt-5">
        <%= paginate @products %>
      </div>
    </div>
  </div>
</section>
