<section class="content">
  <div class="container">
    <% if @category.name && @category.image.blank? %>
      <h1><%= @category.name %></h1>
    <% else %>
      <div class="jumbotron category-jumbotron" style="background-image: url('<%= @category.image.url %>');">
        <div class="row">
          <div class="col-md-5 category-jumbotron-callout">
            <h1 class="text-white brand-heading"><%= @category.name %></h1>
            <br/>
            <p class="lead text-white">
              <%= @category.description %>
            </p>
            <p class="lead text-white">
              Check out available models below
            </p>
          </div>
        </div>
      </div>
    <% end %>
    <% if @products.blank? %>
      <br/>
      <br/>
      <div class="text-center">
        <%= "Sorry, there are currently no #{@category.name.capitalize} products for sale." %>
      </div>
    <% end %>
    <div class="container">
      <div class="row">
        <% @products.each do |product| %>
          <div class="col-xl-3 col-lg-4 col-md-6 col-12 mb-4">
            <div class="card media-card border-0 shadow-lg h-100 overflow-hidden text-white position-relative">
              <!-- Background Image -->
              <img src="<%= product.main_image&.medium&.url %>" class="media-card-img" alt="<%= product.name %>" loading="lazy">
              <!-- Dark Gradient Overlay -->
              <div class="media-card-overlay"></div>
              <!-- Top Card Badge Area -->
              <div class="p-3 d-flex justify-content-between align-items-start media-card-top-content">
                <span class="badge badge-warning font-weight-bold shadow-sm text-dark hero-price">
                  <% if product.discount_percentage > 0 %>
                    <span class="text-danger pr-2">On Sale!</span>
                  <% end %>
                  <strong>$<%= product.current_price.floor %><span class='cents'><%= ("%.2f" % product.current_price).split('.')[1] %></span></strong>
                </span>
              </div>

              <!-- Card Body Anchored at Bottom -->
              <div class="card-body media-card-body d-flex flex-column justify-content-end p-3">
                <h3 class="h5 card-title font-weight-bold mb-1">
                  <%= link_to "#{product.product_code} #{product.name}",
                              { :controller => :store, :action => :product_details, :product_code => product.product_code, :product_name => product.name.to_snake_case },
                              class: "text-white text-decoration-none stretched-link" %>
                </h3>

                <p class="card-text text-light small mb-3">
                  <%= snippet(product.description, word_count: 14) %>
                </p>

                <!-- Dual Action Buttons -->
                <div class="mt-2 media-card-action d-flex align-items-center justify-content-between position-relative" style="z-index: 3;">
                  <%= link_to({ :controller => :store, :action => :product_details, :product_code => product.product_code, :product_name => product.name.to_snake_case },
                              class: 'btn btn-outline-light btn-sm font-weight-bold flex-grow-1 mr-2', aria: { label: "View details for #{product.name}" }) do %>
                    View Details &rarr;
                  <% end %>

                  <%= button_to add_to_cart_path(product.product_code),
                                method: :post,
                                class: 'btn btn-primary btn-sm px-3',
                                data: { disable_with: '<i class="fas fa-spinner fa-spin"></i>' },
                                form: { class: 'd-inline-block mb-0' },
                                title: "Add to Cart" do %>
                    <i class="fas fa-cart-plus" aria-hidden="true"></i>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <div class="d-flex justify-content-center mt-5">
        <%= paginate @products %>
      </div>
    </div>
  </div>
</section>
