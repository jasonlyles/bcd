<div class="background">
  <div class="short-background">
    <div id="notifications" role="alert">
      <%= render partial: 'shared/notifications' %>
    </div>
  </div>

  <section id="hero">
    <div class="container">
      <div class="row">
        <div class="col-lg-9 col-md-8">
          <h1 class="brand-heading mt-4">Welcome to Brick City Depot</h1>
          <p class="intro-text">
            At Brick City Depot, we make
            <strong>affordable</strong>,
            <strong>high quality</strong>
            instructions to help you expand your Lego® collection and building skills.
          </p>
          <div class="mt-5 pt-2">
            <div class="row no-gutters">
              <div class="col-12 col-md-auto mb-3">
                <%= link_to 'Shop Instructions', '#instructions', class: 'scroll-to-anchor btn btn-primary btn-lg w-100' %>
              </div>

              <div class="col-12 col-md-auto d-flex ml-lg-2">
                <%= link_to 'Shop Books', books_path, class: 'btn btn-outline-brick btn-lg mb-3 mr-2 flex-fill' %>
                <%= link_to 'Shop Kits', store_products_path(product_type_name: 'kits'), class: 'btn btn-outline-brick btn-lg mb-3 flex-fill' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="news" class="pt-3 mt-5">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-9">
          <h2 class="text-center text-white">News</h2>
          <%= render partial: 'shared/carousel', locals: { updates: @updates, preview: false } %>
        </div>
      </div>
    </div>
  </section>

  <section class="section-spacer" style="height: 25px;"></section>

  <section class="pt-3 mt-3 pt-md-5 mt-md-5">
    <div class="container">
      <div class="row">
        <div class="col-sm position-relative">
          <h2 class="text-center text-white">Books</h2>
          <div class="card flex-md-row mb-4 box-shadow">
            <div class="card-body d-flex flex-column align-items-start">
              <strong class="d-inline-block mb-2 text-primary">Books</strong>
              <h3 class="mb-0">
                Our 2nd book!
              </h3>
              <p class="card-text">
                Check out our 2nd book! The book is published by No Starch Press and is available all over the internet, and also in Barnes & Noble stores.
              </p>
              <%= link_to 'Continue reading', '/books' %>
            </div>
            <%= link_to(image_tag('lego_neighborhood_2.jpg', class: "card-img-right flex-auto img-fluid", alt: "The Lego Neighborhood Book 2", loading: "lazy"), "/books") %>
          </div>
          <%= picture_tag("figs/hanging.avif", "figs/hanging.png", id: 'hanging-fig', image: { alt: "Hanging Minifig", class: "img-fluid sigfig d-none d-md-block" }) %>
        </div>

        <% featured_items.each do |product| %>
          <div class="col-sm mt-3 mt-sm-0">
            <h2 class="text-center text-white">Featured Product</h2>
            <div class="card flex-md-row mb-4 box-shadow">
              <div class="card-body d-flex flex-column align-items-start">
                <strong class="d-inline-block mb-2 text-success">Instructions</strong>
                <h3 class="mb-0">
                  <%= product.discount_percentage.to_i %>% Off All <%= current_month %>!
                </h3>
                <% unless product.nil? %>
                  <p class="text-muted"><%= "#{product.product_code} #{product.name}" %></p>
                  <p class="card-text mb-auto"><%= snippet(product.description, word_count: 15) %></p>
                  <%= link_to "Continue Reading", {:controller => :store, :action => :product_details, :product_code => product.product_code, :product_name => product.name.to_snake_case} %>
                <% end %>
              </div>
              <% unless product.nil? || product.main_image.blank? %>
                <%= link_to(image_tag(product.main_image.medium.url, class: 'card-img-right flex-auto img-fluid', alt: "#{product.name}", loading: "lazy"), controller: :store, action: :product_details, product_code: product.product_code, product_name: product.name.to_snake_case) unless product.main_image.medium.blank? %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="row pt-2 mt-2 pt-md-1 mt-md-1">
        <div class="col-lg-5 col-md-6 offset-md-6 offset-lg-4">
          <h2 class="text-center text-white">Free instructions!</h2>
          <div class="card">
            <a href="/CV013/adventure_truck"><img class="img-fluid object-fit-contain" loading="lazy" style="height: 248px" alt="Adventure Truck" src="https://d1f3s1yrq7p474.cloudfront.net/assets/adventure_truck_banner-887c0a0e23cc82f348e84e10e47dc9070ee605e0e37d8fed5f32894dc01c4699.jpg"></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="instructions" class="pt-3 mt-3 pt-md-5 mt-md-5">
    <div class="container">
      <h2 class="text-center text-white">Instructions</h2>
      <div class="row">
        <% @products.each do |product| %>
          <div class="col-md-4 col-lg-3 d-flex">
            <%= render 'store/product_teaser_medium', product: product %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="section-spacer" style="height: 100px;"></section>
</div>
